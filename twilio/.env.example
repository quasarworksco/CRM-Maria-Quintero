# Copia este archivo como .env (NO lo subas a GitHub) o pega estas variables en
# Twilio → Functions and Assets → Services → crm-telefono → Environment Variables.

# Clave de API (Account → API keys & tokens → Create API key). El secreto se muestra una sola vez.
API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_SECRET=pega_aqui_el_secreto
# TwiML App (Voice → Manage → TwiML apps) que apunta a https://TU-DOMINIO.twil.io/voice
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Números comprados en formato +1XXXXXXXXXX
NUMBER_FL=+14070000000
NUMBER_PR=+17870000000
# CRM (no son secretos)
FIREBASE_PROJECT_ID=crm-maria-8f7af
OWNER_EMAIL=inventusmq@gmail.com
ALLOWED_ORIGIN=https://crmsystempb.dgp-link.com
COMPANY_NAME=Maria Quintero
# Horario de llamadas de las agentes (la administración y la supervisión no tienen límite)
CALL_HOURS=10:30-19:30
CALL_TZ=America/New_York
# Grabar llamadas (true / false). Si es true se avisa a la persona que contesta.
RECORD_CALLS=false
# Quiénes reciben las llamadas entrantes: identidades del CRM separadas por comas
# (la parte antes del punto que muestra "Probar conexión", por ejemplo us_mup8go7mklcuxs)
INBOUND_IDENTITIES=
